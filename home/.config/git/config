[advice]
	skippedCherryPicks = false

[alias]
	a = "add"
	ap = "add --patch"
	b = "branch"
	bl = "blame"
	ca = "commit --amend"
	cam = "commit --amend --message"
	can = "commit --amend --no-edit"
	co = "checkout"
	cp = "cherry-pick"
	d = "diff"
	dc = "diff --cached"
	ds = "diff --stat"
	dw = "diff --word-diff"
	f = "fetch"
	fixup = "commit --fixup"
	fp = "format-patch"
	lg = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold cyan)<%an>%Creset' --abbrev-commit"
	lga = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold cyan)<%an>%Creset' --abbrev-commit --all"
	lp = "log --pretty=format:'%Cred%h%Creset - %s %Cgreen(%cr) %C(bold cyan)<%an>%Creset'"
	pl = "pull --rebase"
	ps = "push"
	psf = "push --force-with-lease"
	rb = "rebase"
	rba = "rebase --abort"
	rbc = "rebase --continue"
	ri = "rebase --interactive"
	rs = "restore"
	rss = "restore --staged"
	st = "status --short --branch"
	sw = "switch"
	uncommit = "reset --soft HEAD~1"
	undo = "reset --soft HEAD~1"
	unstage = "restore --staged"
	who = "shortlog --summary --numbered --email"
	wip = "commit --no-verify --message WIP"

[branch]
	sort = "-committerdate"

[column]
	ui = "auto"

[core]
	autocrlf = "input"
	editor = "nvim"

[init]
	defaultBranch = "main"

[diff]
    algorithm = "histogram"

