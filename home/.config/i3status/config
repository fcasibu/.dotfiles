# i3status configuration file.
# see "man i3status" for documentation.

general {
        colors = true
        interval = 5
        color_good = "#FF9E00"
        color_degraded = "#C9B87A"
        color_bad = "#C87A7A"
}

order += "cpu_usage"
order += "memory"
order += "disk /"
order += "tztime local"

cpu_usage {
        format = "CPU %usage"
}

memory {
        format = "MEM %used/%total"
        threshold_degraded = "20%"
        format_degraded = "MEM < %available"
}

disk "/" {
        format = "DISK %avail"
}

tztime local {
        format = "%Y-%m-%d %H:%M"
}